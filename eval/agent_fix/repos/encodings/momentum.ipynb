   "source": [
    "import pandas as pd\n",
    "df = pd.read_csv(\"prices.csv\", parse_dates=[\"date\"], index_col=\"date\")"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "df[\"mom\"] = df[\"close\"].pct_change(-10)\n",
    "df[\"signal\"] = (df[\"mom\"] > 0).astype(int)"
   ]
  }
